# Winder agent sozlamalari. Bu faylni ".env" nomi bilan nusxalang va qiymatlarni kiriting.
# .env faylini hech qachon GitHub'ga yuklamang.

# Claude API kaliti: https://console.anthropic.com -> API Keys
# Bo'sh qolsa agent kalit so'zlar bo'yicha ishlaydi, AI tahlil va chat o'chiq bo'ladi.
ANTHROPIC_API_KEY=

# Claude modeli (ixtiyoriy)
WINDER_MODEL=claude-opus-5-5

# Telegram bot: @BotFather'dan token oling, botga /start yozing, chat ID'ni bot o'zi aytadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lokal server porti (brauzerda http://localhost:7420)
WINDER_PORT=7420

# 0 qilsangiz brauzer oynasi ko'rinib turadi (sozlash uchun qulay)
WINDER_HEADLESS=1

# Agent ishga tushganda darhol bir marta tekshirsinmi (1 = ha)
WINDER_SCAN_ON_START=0
