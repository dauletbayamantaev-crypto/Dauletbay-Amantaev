# ---------- Firebase (bulutda saqlash va login) ----------
# Firebase konsoli → Project settings → Your apps → Web app → SDK config.
# Bu qiymatlar maxfiy emas (brauzerga ochiq bo'ladi); himoyani firestore.rules ta'minlaydi.
# Bo'sh qoldirilsa, ilova "mahalliy rejim"da ishlaydi (ma'lumotlar faqat shu brauzerda).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ---------- AI ----------
# Ixtiyoriy: Google AI Studio bu kalitni avtomatik qo'yadi. Aks holda kalitlarni
# ilova ichida "Sozlamalar" bo'limida kiritasiz (ular faqat brauzerda saqlanadi).
GEMINI_API_KEY=""
